# ReviewMate AI Environment Configuration
# Never commit .env with real tokens!

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=

# Groq Model name (defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# GitHub Personal Access Token (classic with repo scope or fine-grained with Pull Requests: Read & Write)
# Optional for reading public PRs (subject to unauthenticated rate limits), required for posting review comments
GITHUB_TOKEN=

# Server Configuration
HOST=127.0.0.1
PORT=8000
